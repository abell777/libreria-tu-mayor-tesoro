rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // 👉 Sustituye estos valores por tus UID reales de Firebase Authentication
      return isSignedIn() && request.auth.uid in [
        'EPkK3ItKBRhA5bNeqs9PKbM0svB3'
      ];
    }

    // Cadena no vacía y por debajo de un tamaño razonable (evita spam/abuso
    // de almacenamiento a través de campos de texto libre).
    function isReasonableString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // ---- usuarios/{uid} — perfil y direcciones guardadas ------------------
    // Solo el propio usuario puede leer o escribir su documento. Se limita
    // el tamaño de "direcciones" para que nadie pueda usar el documento
    // como almacén gratuito de datos arbitrarios.
    match /usuarios/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        (!('direcciones' in request.resource.data) ||
          (request.resource.data.direcciones is list &&
           request.resource.data.direcciones.size() <= 10)) &&
        (!('nombre' in request.resource.data) ||
          isReasonableString(request.resource.data.nombre, 120)) &&
        (!('telefono' in request.resource.data) ||
          isReasonableString(request.resource.data.telefono, 40));
    }

    // ---- pedidos/{pedidoId} — encargos realizados en el checkout ----------
    match /pedidos/{pedidoId} {
      // Un cliente solo puede ver SUS pedidos; el admin los ve todos.
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      // Crear un pedido: SOLO puede hacerlo la Cloud Function "crearPedido"
      // (functions/index.js), que usa el SDK de administrador y por tanto
      // se salta estas reglas por diseño. Por eso aquí se deniega siempre:
      // si un cliente pudiera escribir un pedido directamente, se saltaría
      // el recálculo de precios en el servidor y podría fabricar pedidos
      // con precios/artículos inventados a mano desde la consola del
      // navegador (antes había aquí una regla que lo "limitaba" pero no lo
      // impedía del todo). Ahora el único camino para crear un pedido es
      // pasar por esa función, que sí es de confianza.
      allow create: if false;

      // Actualizar un pedido: solo el admin (para cambiar el estado desde
      // el panel), solo puede tocar "estado", y solo a uno de los tres
      // valores válidos del flujo de pedidos. Nótese que "pagado" NO está
      // en la lista de campos permitidos aquí a propósito: ni el cliente
      // ni el admin pueden marcarlo desde el navegador. Solo lo cambia la
      // Cloud Function "stripeWebhook" (SDK de administrador, se salta
      // estas reglas), cuando Stripe confirma que el pago es real.
      // El propio cliente, además, puede marcar SU pedido como recibido
      // ("He recibido mi pedido" en cuenta.html): solo cuando el admin ya
      // lo puso en "enviado", solo una vez (no puede haber "confirmadoCliente"
      // previo) y solo puede tocar esos dos campos, con la fecha real del
      // servidor. Esto dispara el correo de "avisoPedidoRecibido" (Cloud
      // Function) invitando a valorar los libros.
      allow update: if (isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
        request.resource.data.estado in ['pendiente', 'enviado', 'entregado']) ||
        (isSignedIn() && resource.data.uid == request.auth.uid &&
          resource.data.estado == 'enviado' &&
          !('confirmadoCliente' in resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmadoCliente', 'confirmadoClienteEn']) &&
          request.resource.data.confirmadoCliente == true &&
          request.resource.data.confirmadoClienteEn == request.time);

      // Nadie puede borrar pedidos (ni siquiera el admin, para conservar
      // el historial). Si algún día quieres permitirlo, cambia esta línea
      // a "if isAdmin();".
      allow delete: if false;
    }

    // ---- encargos/{encargoId} — pedidos personalizados --------------------
    // Solicitudes del formulario de personalizado.html. El cliente las crea
    // siempre "en-revision" y NUNCA puede escribir un precio: el precio final
    // solo lo anota el administrador desde el panel, después de montar la
    // portada. Así nadie puede fabricarse un encargo ya presupuestado.
    match /encargos/{encargoId} {
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.estado == 'en-revision' &&
        request.resource.data.createdAt == request.time &&
        isReasonableString(request.resource.data.libroTitulo, 200) &&
        isReasonableString(request.resource.data.clienteNombre, 140) &&
        isReasonableString(request.resource.data.clienteEmail, 200) &&
        isReasonableString(request.resource.data.portadaUrl, 1000) &&
        request.resource.data.cantidad is number &&
        request.resource.data.cantidad >= 1 &&
        request.resource.data.cantidad <= 50 &&
        (!('notas' in request.resource.data) || request.resource.data.notas.size() <= 800) &&
        (!('textoPortada' in request.resource.data) || request.resource.data.textoPortada.size() <= 120) &&
        !('precioFinal' in request.resource.data);

      // El administrador solo puede tocar el estado, el precio final y un
      // mensaje para el cliente. Nada más.
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['estado', 'precioFinal', 'mensajeAdmin']) &&
        request.resource.data.estado in
          ['en-revision', 'presupuestado', 'aceptado', 'en-produccion', 'enviado', 'cancelado'];

      allow delete: if false;
    }

    // ---- resenas/{resenaId} — opiniones de clientes sobre los libros -----
    match /resenas/{resenaId} {
      // Las opiniones son públicas: cualquiera puede leerlas, incluso sin
      // haber iniciado sesión (así se ven en la ficha de producto).
      allow read: if true;

      // Crear una opinión: debe ir firmada con tu propio uid, referenciar
      // un producto, con una valoración de 1 a 5 y un comentario de
      // longitud razonable (evita spam/abusos). "fotos" es opcional (hasta
      // 4 URLs de Storage, subidas antes desde js/product.js).
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        isReasonableString(request.resource.data.productId, 120) &&
        isReasonableString(request.resource.data.nombre, 120) &&
        request.resource.data.valoracion is number &&
        request.resource.data.valoracion >= 1 &&
        request.resource.data.valoracion <= 5 &&
        isReasonableString(request.resource.data.comentario, 600) &&
        (!('fotos' in request.resource.data) ||
          (request.resource.data.fotos is list && request.resource.data.fotos.size() <= 4));

      // Solo el autor puede editar o borrar su propia opinión — y al
      // editarla, sigue teniendo que cumplir las mismas reglas de
      // valoración/comentario (antes se podía "editar" para saltárselas).
      // "utilesCount" queda fuera de aquí a propósito: solo lo toca la
      // Cloud Function (SDK de administrador, se salta estas reglas), así
      // que si algún día alguien intenta escribirlo desde el navegador
      // junto a una edición, esa edición se rechaza entera.
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.valoracion is number &&
        request.resource.data.valoracion >= 1 &&
        request.resource.data.valoracion <= 5 &&
        isReasonableString(request.resource.data.comentario, 600) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['valoracion', 'comentario', 'fotos']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // ---- resenas/{resenaId}/utiles/{uid} — voto de "¿te fue útil?" ----
      // Un documento (vacío, solo con la fecha) por persona y opinión: su
      // sola existencia es el voto. El contador que se ve en la tarjeta
      // (resenas/{resenaId}.utilesCount) lo mantiene únicamente la Cloud
      // Function "sumarVotoUtil"/"restarVotoUtil" (SDK de administrador),
      // nunca el navegador.
      match /utiles/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid &&
          request.resource.data.keys().hasOnly(['createdAt']) &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- newsletter/{docId} — altas del formulario del footer ------------
    // No estaba cubierta por las reglas anteriores: sin esta entrada,
    // Firestore la deniega por defecto y el formulario "Avísame" del pie de
    // página falla siempre con "No se ha podido guardar" (js/main.js).
    // Cualquier visitante puede darse de alta (no requiere sesión), pero
    // nadie puede leer, editar ni borrar la lista desde el navegador — para
    // consultarla o exportarla, usa la consola de Firebase (Firestore).
    match /newsletter/{docId} {
      allow create: if isReasonableString(request.resource.data.email, 200) &&
        request.resource.data.keys().hasOnly(['email', 'createdAt']) &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---- promos/{codigo} — códigos de descuento --------------------------
    // Se crean y editan a mano desde la consola de Firebase (Firestore);
    // todavía no hay pantalla en la web para gestionarlos. El navegador
    // nunca lee ni escribe aquí directamente: solo lo hacen las Cloud
    // Functions "validarPromo" y "crearPedido" (SDK de administrador, se
    // saltan estas reglas). Por eso se deniega todo desde el cliente — así
    // nadie puede fabricarse un descuento a mano ni ver qué códigos existen
    // inspeccionando Firestore desde el navegador. Lo mismo aplica a la
    // subcolección "usos" (cuenta cuántas veces ha usado cada cliente cada
    // código).
    match /promos/{codigo} {
      allow read, write: if false;
      match /usos/{uid} {
        allow read, write: if false;
      }
    }

    // ---- limites/{clave} — contador del límite de intentos ----------------
    // Lo usan internamente "crearPedido", "validarPromo" y
    // "buscarPedidoPublico" (SDK de administrador) para frenar el abuso.
    // No tiene ningún dato personal, solo un contador y una marca de
    // tiempo — pero tampoco hay motivo para que nadie lo lea o lo toque
    // desde el navegador.
    match /limites/{clave} {
      allow read, write: if false;
    }

    // ---- carritosAbandonados/{uid} — snapshot del carrito para el aviso --
    // ---- por correo de "carrito abandonado" (1 documento por usuario) ----
    // Lo escribe js/cart.js, solo mientras hay sesión iniciada (sin sesión
    // no hay email al que avisar). Nunca guarda precios — solo id, título
    // y cantidad; el precio real lo vuelve a calcular la Cloud Function
    // "recordatorioCarritoAbandonado" contra el catálogo del servidor,
    // igual que "crearPedido". Nadie puede leerlo desde el navegador (ni
    // siquiera el propio dueño): solo lo lee esa Cloud Function, con el
    // SDK de administrador, que se salta estas reglas.
    match /carritosAbandonados/{uid} {
      allow read: if false;

      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        isReasonableString(request.resource.data.email, 200) &&
        (!('nombre' in request.resource.data) || request.resource.data.nombre is string) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 30 &&
        // Solo puede llegar como "false": el aviso de que el correo YA se
        // envió (true) lo pone exclusivamente la Cloud Function (SDK de
        // administrador), nunca el navegador.
        request.resource.data.recordatorioEnviado == false &&
        // Fuerza a que sea la marca de tiempo real del servidor, nunca una
        // fecha inventada por el cliente (mismo patrón que "encargos").
        request.resource.data.actualizadoEn == request.time;

      // Al vaciar el carrito, js/cart.js borra este documento directamente.
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- deseos/{uid} — lista de deseos (1 documento por usuario) --------
    // No estaba cubierta por las reglas anteriores: sin esta entrada,
    // Firestore la deniega por defecto y la lista de deseos no funciona
    // para nadie. Solo el propio usuario puede leer o escribir la suya.
    match /deseos/{uid} {
      // "request.resource" solo existe en escrituras: usarlo también en la
      // condición de "read" (como estaba antes) hace que Firestore evalúe
      // la regla como denegada siempre que se intenta LEER la lista de
      // deseos, y de ahí el "permission-denied" al cargarla. Separando
      // lectura y escritura, el propio usuario puede leer su documento sin
      // más condición, y la validación de "items" se aplica solo al
      // guardar.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        (!('items' in request.resource.data) ||
          (request.resource.data.items is list && request.resource.data.items.size() <= 200));
    }
  }
}
