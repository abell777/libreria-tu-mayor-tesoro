  background: var(--background, #ffffff);
  color: var(--foreground, #111827);
}

.promo-form button,
.promo-form .btn {
  flex: 0 0 auto;
  width: auto;
  min-width: unset;
  padding: 0.6rem 1rem;
  border-radius: 8px;
  border: 1px solid var(--border, #d1d5db);
  background: #f3f4f6;
  color: var(--foreground, #111827);
  font-weight: 600;
  font-size: 0.875rem;
  cursor: pointer;
  white-space: nowrap;
}

.promo-form button:hover {
