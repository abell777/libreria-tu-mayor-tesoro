}
.custom-quote-label { display: block; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted-foreground); }
.custom-quote-value { font-family: var(--font-serif); font-size: 1.7rem; color: var(--navy); }
.custom-quote-note { font-size: 0.78rem; color: var(--muted-foreground); margin: 6px 0 0; }

.custom-progress { margin-bottom: 14px; }
.custom-progress-bar { height: 6px; background: var(--muted); border-radius: 99px; overflow: hidden; margin-bottom: 6px; }
.custom-progress-bar span { display: block; height: 100%; width: 0; background: var(--gold); transition: width 0.25s ease; }

.custom-actions { flex-direction: column; align-items: flex-start; gap: 8px; }

.custom-aside { display: flex; flex-direction: column; gap: 18px; position: sticky; top: 16px; }
.custom-aside-card {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--muted);
  padding: 20px;
}
.custom-aside-card .account-subheading { margin-top: 0; }
.custom-aside-card p { font-size: 0.85rem; color: var(--muted-foreground); }

.custom-list { display: flex; flex-direction: column; gap: 12px; }
.custom-list-item {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  padding: 12px 14px;
}
.custom-list-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
.custom-list-head h3 { font-family: var(--font-serif); font-size: 0.95rem; margin: 0 0 4px; color: var(--navy); }
.custom-list-meta { font-size: 0.78rem; color: var(--muted-foreground); margin: 0; }
.custom-list-precio { font-size: 0.85rem; margin: 6px 0 0; }

.custom-badge {
  flex-shrink: 0;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 99px;
  background: var(--muted);
  color: var(--muted-foreground);
  white-space: nowrap;
}
.custom-badge--en-revision { background: var(--gold-soft); color: var(--navy-deep); }
.custom-badge--presupuestado,
.custom-badge--aceptado { background: oklch(0.92 0.06 150); color: oklch(0.35 0.09 150); }
.custom-badge--cancelado { background: oklch(0.93 0.05 25); color: oklch(0.42 0.14 25); }

.custom-done {
  max-width: 620px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
