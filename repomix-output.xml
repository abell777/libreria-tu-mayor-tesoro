}
.custom-steps h2 { font-family: var(--font-serif); font-size: 1.02rem; margin: 0 0 4px; color: var(--navy); }
.custom-steps p { margin: 0; font-size: 0.86rem; color: var(--muted-foreground); }

/* ---- Confección manual (confeccion-manual.html) ------------------------- */
.handmade-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(24px, 4vw, 48px);
  align-items: center;
