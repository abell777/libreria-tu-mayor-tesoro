  const papel = EW_PAPERS.includes(solicitada.papel) ? solicitada.papel : def.papel;

  const precio = getEWPrice(bookId, tipo, tamano, acabado, papel);
  if (precio === null) return null;

  const sizeInfo = EW_SIZE_LABELS[tamano];
  const formato =
    (tipo === "dura" ? "Tapa dura" : "Tapa blanda") +
    (sizeInfo ? ", " + sizeInfo.label + " (" + sizeInfo.dims + ")" : "") +
    " · " + (acabado === "mate" ? "Mate" : "Brillo") +
    " · " + EW_PAPER_LABELS[papel];

  return { tipo, tamano, acabado, papel, precio, formato };
}

