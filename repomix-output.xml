            <button type="button" id="verifyLogout" class="auth-forgot-link">Cerrar sesión</button>
          </div>
        </form>
      </div>
      <p class="auth-hint verify-hint">¿No llega? Mira en la carpeta de spam. El código vale 10 minutos.</p>
