// Recibe lo que mande el navegador (item.imp = { tipo, tamano, acabado, papel })
// y devuelve SIEMPRE una combinación válida y su precio ya verificado: si
// falta algo o no es válido, se usa la combinación por defecto del libro
// (la que ya tenía publicada) — nunca se confía en el precio del navegador.
function resolverImpresion(bookId, impSolicitada) {
  const def = EW_BOOK_DEFAULTS[bookId];
