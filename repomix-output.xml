        <section class="custom-block">
          <h2 class="account-subheading">1. El libro</h2>
          <label>Título
            <select name="libro" id="customBookSelect" required></select>
          </label>
          <label id="customOtherTitleWrap" hidden>Dinos qué título quieres
            <input type="text" name="otroTitulo" id="customOtherTitle" placeholder="Título y, si lo sabes, autor o editorial">
          </label>
          <div class="account-form-row">
            <label>Cantidad
              <input type="number" name="cantidad" id="customCantidad" value="1" min="1" max="50" required>
            </label>
            <label>Encuadernación
              <select name="encuadernacion" required>
                <option value="Tapa blanda">Tapa blanda</option>
                <option value="Tapa dura">Tapa dura</option>
              </select>
            </label>
          </div>
        </section>

        <section class="custom-block">
          <h2 class="account-subheading">2. Cómo lo quieres</h2>
          <div class="account-form-row">
            <label>Tamaño
              <select name="tamano" id="customTamano" required>
                <option value="A5 (15 × 21 cm)">A5 (15 × 21 cm)</option>
                <option value="Bolsillo (11 × 18 cm)">Bolsillo (11 × 18 cm)</option>
                <option value="A4 (21 × 29,7 cm)">A4 (21 × 29,7 cm)</option>
                <option value="otro">Otro (lo indico abajo)</option>
              </select>
            </label>
            <label id="customOtherSizeWrap" hidden>Tamaño que necesitas
              <input type="text" name="otroTamano" placeholder="Por ejemplo, 17 × 24 cm">
            </label>
          </div>
          <div class="account-form-row">
            <label>Acabado de cubierta
              <select name="acabado" required>
                <option value="Brillo">Brillo</option>
                <option value="Mate">Mate</option>
                <option value="Soft touch">Soft touch</option>
              </select>
            </label>
            <label>Papel interior
              <select name="papel" required>
                <option value="Offset blanco">Offset blanco</option>
                <option value="Crema (ahuesado)">Crema (ahuesado)</option>
                <option value="Blanco semibrillante">Blanco semibrillante</option>
              </select>
            </label>
          </div>
        </section>

        <section class="custom-block">
          <h2 class="account-subheading">3. Tu portada</h2>
          <p class="custom-help">Sube la imagen que quieres en la cubierta (JPG, PNG o WEBP). No hace falta que esté montada ni recortada: del diseño nos encargamos nosotros. Cuanta más resolución, mejor quedará impresa.</p>
          <div class="custom-upload">
            <input type="file" id="customCover" name="portada" accept="image/jpeg,image/png,image/webp" required>
            <div class="custom-preview" id="customPreview" hidden>
              <img id="customPreviewImg" alt="Vista previa de la imagen que has subido">
              <div>
                <p class="custom-preview-name" id="customPreviewName"></p>
                <button type="button" class="btn btn--outline btn--sm" id="customRemoveImg">Quitar imagen</button>
              </div>
            </div>
          </div>
          <label><span>Texto que quieres en la portada <span class="custom-optional">(opcional)</span></span>
            <input type="text" name="textoPortada" maxlength="120" placeholder="Nombre, dedicatoria breve, versículo…">
          </label>
        </section>

        <section class="custom-block">
          <h2 class="account-subheading">4. Tus datos</h2>
          <div class="account-form-row">
            <label>Nombre y apellidos
              <input type="text" name="nombre" id="customNombre" required autocomplete="name">
            </label>
            <label>Correo electrónico
              <input type="email" name="email" id="customEmail" required autocomplete="email">
            </label>
          </div>
          <label><span>Teléfono <span class="custom-optional">(opcional)</span></span>
            <input type="tel" name="telefono" id="customTelefono" autocomplete="tel">
          </label>
          <label><span>Notas para nosotros <span class="custom-optional">(opcional)</span></span>
            <textarea name="notas" rows="4" maxlength="800" placeholder="Fecha para la que lo necesitas, colores que prefieres, cualquier detalle…"></textarea>
          </label>
          <label class="checkbox-label"><input type="checkbox" name="privacidad" id="customPrivacidad" required> <span>He leído y acepto la <a href="privacidad.html" class="link-inline">política de privacidad</a>.</span></label>
        </section>

        <!-- Presupuesto al instante: desactivado por ahora (ver js/personalizado.js) -->
        <div class="custom-quote" id="customQuote" hidden>
          <span class="custom-quote-label">Precio estimado</span>
          <span class="custom-quote-value" id="customQuoteValue">—</span>
          <p class="custom-quote-note">Estimación orientativa. Confirmaremos el precio final con la portada montada.</p>
        </div>

        <p class="auth-error" id="customError" role="alert" hidden></p>
        <div class="custom-progress" id="customProgress" hidden>
          <div class="custom-progress-bar"><span id="customProgressBar"></span></div>
