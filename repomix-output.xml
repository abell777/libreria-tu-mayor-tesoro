};

function ewTableKey(tipo, tamano) {
  if (tipo === "blanda") {
    if (tamano === "bolsillo") return "bolsillo";
    if (tamano === "a5") return "a5";
    if (tamano === "mediano") return "mediano_blanda";
  } else if (tipo === "dura") {
    if (tamano === "mediano") return "mediano_dura";
    if (tamano === "grande") return "grande_dura";
  }
  return null;
}

function ewColumnKey(tipo, acabado, papel) {
  if (tipo === "blanda") {
    const ac = acabado === "mate" ? "mate" : "brillo";
    const pa = papel === "crema" ? "crema" : papel === "semi" ? "semi" : "offset";
    return ac + "_" + pa;
  }
  return papel === "crema" ? "crema" : papel === "semi" ? "semi" : "offset";
}

function ewComboMatches(a, tipo, tamano, acabado, papel) {
  return a.tipo === tipo && a.tamano === tamano && a.acabado === acabado && a.papel === papel;
}

function getEWRawPrice(pdfTitle, tipo, tamano, acabado, papel) {
  const byTitle = EW_PRICE_TABLE[pdfTitle];
  if (!byTitle) return null;
  const sizeKey = ewTableKey(tipo, tamano);
  if (!sizeKey) return null;
  const sizeData = byTitle[sizeKey];
  if (!sizeData) return null;
  const v = sizeData[ewColumnKey(tipo, acabado, papel)];
  return typeof v === "number" ? v : null;
}

// Precio final a cobrar para (bookId, combinación elegida). Es la ÚNICA
