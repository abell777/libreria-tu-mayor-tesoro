.admin-view-tab {
  padding: 10px 4px; margin-bottom: -1px; border: none; border-bottom: 2px solid transparent; background: none;
  font-family: var(--font-sans); font-size: 0.92rem; font-weight: 700; color: var(--muted-foreground); cursor: pointer;
}
.admin-view-tab + .admin-view-tab { margin-left: 18px; }
.admin-view-tab:hover { color: var(--navy); }
