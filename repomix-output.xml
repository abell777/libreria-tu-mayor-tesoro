        '<p style="font-size:0.85em;color:#777">Cualquier duda, escríbenos a <a href="mailto:libreriamayortesoro@gmail.com">libreriamayortesoro@gmail.com</a>.</p></div>',
    }).catch((e) => console.error("Correo de reembolso al cliente:", e));
