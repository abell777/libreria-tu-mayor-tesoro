const EW_SIZES_BY_TIPO = {
  blanda: ["bolsillo", "a5", "mediano"],
  dura: ["mediano", "grande"],
};

const EW_PAPERS = ["crema", "offset", "semi"];
const EW_FINISHES = ["mate", "brillo"];
const EW_PDF_SURCHARGE = 1.50;

const EW_SIZE_LABELS = {
  bolsillo: { label: "Bolsillo", dims: "110 x 180 mm" },
  a5: { label: "A5", dims: "148 x 210 mm" },
  mediano: { label: "Mediano", dims: "155 x 235 mm" },
