}
.handmade-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
.handmade-content .custom-intro { margin-bottom: 1.1rem; }
.handmade-content .coming-soon-notice { margin-bottom: 1.4rem; }

.handmade-preview .account-subheading { margin-bottom: 1rem; }
.handmade-steps li:first-child { border-color: var(--gold-soft); background: var(--parchment); }
.handmade-steps li:first-child .custom-step-num { background: var(--gold); color: var(--navy-deep); }

@media (max-width: 760px) {
  .handmade-hero { grid-template-columns: 1fr; }
  .handmade-steps { grid-template-columns: 1fr; }
}

.custom-login-notice {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--card);
  box-shadow: var(--shadow-card);
  padding: 28px;
  max-width: 560px;
}
.custom-login-notice p { color: var(--muted-foreground); margin-bottom: 1rem; }

.custom-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  gap: 28px;
  align-items: start;
}

.custom-form { max-width: none; }
.custom-form select,
.custom-form textarea,
.custom-form input[type="file"] {
  font: inherit;
  padding: 11px 13px;
  border: 1px solid var(--border);
  border-radius: var(--radius-md);
  background: var(--background);
  color: var(--foreground);
  width: 100%;
}
.custom-form textarea { resize: vertical; min-height: 96px; }
.custom-form input:focus-visible,
.custom-form select:focus-visible,
.custom-form textarea:focus-visible { outline: 2px solid var(--gold); outline-offset: 1px; }

.custom-block {
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--card);
  padding: 22px 24px;
  margin-bottom: 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.custom-block .account-subheading { margin: 0; }

.custom-help { font-size: 0.82rem; color: var(--muted-foreground); margin: 0; }
.custom-optional { font-weight: 400; color: var(--muted-foreground); }

.custom-preview { display: flex; gap: 14px; align-items: center; margin-top: 12px; }
.custom-preview img {
  width: 92px;
  height: 128px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
}
.custom-preview-name { font-size: 0.8rem; color: var(--muted-foreground); margin: 0 0 8px; }

.custom-quote {
  border: 1px solid var(--gold-soft);
  background: var(--parchment);
  border-radius: var(--radius-lg);
  padding: 18px 22px;
