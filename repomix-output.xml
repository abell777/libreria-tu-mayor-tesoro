function getEWPrice(bookId, tipo, tamano, acabado, papel) {
  const partes = EW_COLLECTIONS[bookId];
  if (partes) {
    let total = 0;
    for (const id of partes) {
      const p = getEWPriceIndividual(id, tipo, tamano, acabado, papel);
      if (p === null) return null;
