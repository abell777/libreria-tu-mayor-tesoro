.admin-tab-count {
  display: inline-block; min-width: 18px; margin-left: 4px; padding: 1px 6px; border-radius: 999px;
  background: var(--gold); color: var(--navy-deep); font-size: 0.72rem; font-weight: 700; line-height: 1.5;
